    "from scipy.optimize import curve_fit\n",
    "\n",
    "y = rt_filtered.values.astype(float)\n",
    "x = np.arange(len(y))\n",
    "\n",
    "mask = np.isfinite(y)\n",
    "x_clean = x[mask]\n",
    "y_clean = y[mask]\n",
    "\n",
    "# exponential model\n",
    "def exp_model(x, a, b, c):\n",
    "    return a * np.exp(-b * x) + c\n",
    "\n",
    "# fit\n",
    "params, _ = curve_fit(\n",
    "    exp_model,\n",
    "    x_clean,\n",
    "    y_clean,\n",
    "    p0=[1000, 0.01, 2000],   # best guesses\n",
    "    maxfev=10000          \n",
    ")\n",
    "\n",
    "a, b, c = params\n",
    "\n",
    "y_fit_full = exp_model(x, a, b, c)\n",
    "\n",
    "plt.plot(x, y, label=\"reaction tme\")\n",
    "plt.plot(x, y_fit_full, \"r\", label=\"exponential fit\")\n",
    "plt.legend()\n",
    "plt.xlabel(\"trials\")\n",
    "plt.ylabel(\"reaction time\")\n",
    "plt.title(\"reaction time across trials, fitted with an exponential function\")\n",
    "plt.show()"
   ]
  },
