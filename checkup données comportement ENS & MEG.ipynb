    "        df_filtered['stimulus_rotations'] = df_filtered['stimulus_rotations'].apply(lambda s: [] if pd.isna(s) else [float(x) for x in s.split(',')])\n",
    "        df_filtered['score'] = df_filtered['score'].astype(int)\n",
    "        df_filtered[\"expected_angles\"] = df_filtered.apply(lambda row : [x + y for x,y in zip(row[\"presented_angles\"],row[\"stimulus_rotations\"])], axis=1)\n",
    "\n",
    "        df_filtered = df_filtered.dropna(subset=[\"final_angle\"])\n",
    "        df_radian = df_filtered.copy().drop(columns=[\"presented_angles\", \"final_angle\", \"expected_angles\", \"stimulus_rotations\"])\n",
    "        df_radian['final_angle'] = np.deg2rad(df_filtered['final_angle'])\n",
    "\n",
