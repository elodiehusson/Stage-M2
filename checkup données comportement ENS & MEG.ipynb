    "        df_radian[\"expected_angles_wo_rot\"] = df_radian[\"presented_angles\"].apply(CircularMean)\n",
    "        df_radian[\"error_wo_rotation\"] = circular_error(df_radian[\"final_angle\"], df_radian[\"expected_angles_wo_rot\"])  \n",
    "\n",
    "\n",
    "    return df_radian\n",
    "\n",
    "def mean_par_sujet (column) : # gives one value per subject\n",
    "    df_participant = pd.DataFrame()\n",
    "    for participant in range(len(dfs)):\n",
    "        df_participant[participant] = all_participants(dfs[participant])[column]\n",
    "    mean_matrix = df_participant.apply(CircularMean)\n",
    "    return mean_matrix      \n",
    "\n",
    "def sd_par_sujet (column) : \n",
    "    df_participant = pd.DataFrame()\n",
    "    for participant in range(len(dfs)):\n",
    "        df_participant[participant] = all_participants(dfs[participant])[column]\n",
    "    mean_matrix = df_participant.std()\n",
    "    return mean_matrix      \n",
    "\n"
